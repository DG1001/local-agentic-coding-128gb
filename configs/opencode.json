{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ds4": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ds4 lokal (DGX Spark)",
      "options": {
        "baseURL": "http://127.0.0.1:8888/v1",
        "apiKey": "unused",
        "headerTimeout": 600000,
        "timeout": 3600000
